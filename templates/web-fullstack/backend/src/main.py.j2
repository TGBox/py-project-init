from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

app = FastAPI(
    title="{{ project_name }} API",
    description="Backend-API für {{ project_name }}",
    version="0.1.0",
)

# Enable CORS for local Vite development
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173", "http://127.0.0.1:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


class HealthResponse(BaseModel):
    status: str
    app: str
    version: str


@app.get("/api/health", response_model=HealthResponse)
async def get_health() -> HealthResponse:
    """Returns application health status."""
    return HealthResponse(
        status="healthy",
        app="{{ project_name }}",
        version="0.1.0",
    )


@app.get("/api/items")
async def get_items() -> list[dict[str, str]]:
    """Sample endpoint providing initial dashboard items."""
    return [
        {"id": "1", "title": "FastAPI Backend", "description": "Schnelle, asynchrone Python API mit uv"},
        {"id": "2", "title": "Vite & React Frontend", "description": "Moderne reaktive Oberfläche mit TypeScript"},
        {"id": "3", "title": "Docker Compose", "description": "Containerisierte Orchestrierung"},
    ]
