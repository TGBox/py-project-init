import unittest

from textual.widgets import Label

from src.app import {{ project_name | replace("-", " ") | replace("_", " ") | title | replace(" ", "") }}App


class TestAppLifecycle(unittest.IsolatedAsyncioTestCase):
    async def test_app_lifecycle(self) -> None:
        """Verifies the Textual app mounts, toggles theme and handles button clicks."""
        app = {{ project_name | replace("-", " ") | replace("_", " ") | title | replace(" ", "") }}App()
        async with app.run_test() as pilot:
            self.assertTrue(app.is_running)
            await pilot.press("d")
            await pilot.click("#btn_dash")
            status = app.query_one("#status_label", Label)
            self.assertIn("Dashboard", str(status.render()))
