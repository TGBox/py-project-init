func TestGreet(t *testing.T) {
	defaultMsg := Greet("")
	if !strings.Contains(defaultMsg, "Willkommen") {
		t.Errorf("Unerwarteter Standardgruß: %s", defaultMsg)
	}

	customMsg := Greet("Daniel")
	if !strings.Contains(customMsg, "Daniel") {
		t.Errorf("Name fehlt im Gruß: %s", customMsg)
	}
}
