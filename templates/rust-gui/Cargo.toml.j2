[package]
name = "{{ project_slug }}"
version = "0.1.0"
edition = "2021"
description = "{{ description }}"

[dependencies]
{% if framework == "egui" %}
eframe = "0.31"
egui = "0.31"
{% elif framework == "iced" %}
iced = { version = "0.13", features = ["tokio"] }
{% elif framework == "tauri" %}
tauri = { version = "2", features = [] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
{% elif framework == "slint" %}
slint = "1"
{% elif framework == "gtk4" %}
gtk4 = "0.9"
{% endif %}

[[bin]]
name = "{{ project_slug }}"
path = "src/main.rs"
