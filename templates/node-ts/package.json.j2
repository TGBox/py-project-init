{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "description": "{{ description }}",
{% if author %}
  "author": "{{ author }}{% if author_email %} <{{ author_email }}>{% endif %}",
{% endif %}
{% if license %}
  "license": "{{ license }}",
{% endif %}
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
{% set scripts = {"build": "tsc", "start": "node dist/index.js", "dev": "tsx watch src/index.ts", "test": "vitest run", "typecheck": "tsc --noEmit"} %}
{% if custom_scripts %}{% set _ = scripts.update(custom_scripts) %}{% endif %}
{% for s_name, s_cmd in scripts.items() %}
    "{{ s_name }}": "{{ s_cmd }}"{{ "," if not loop.last else "" }}
{% endfor %}
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}