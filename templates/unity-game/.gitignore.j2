# =============================================================================
# Unity .gitignore
# =============================================================================

# Von Unity generierte Arbeits- und temporäre Verzeichnisse
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Aa]ssets/AssetStoreTools*

# Autogenerierte IDE-Projektdateien (Visual Studio / Rider / VS Code)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Temporäre Unity Meta-Dateien
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Crash-Reports
sysinfo.txt

# Erstellte Build-Artefakte
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics & Analytics
crashlytics-build.properties

# Betriebssystem-Dateien
.DS_Store
Thumbs.db
desktop.ini

# IDE-Konfigurationen
.idea/
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# WICHTIG: .meta-Dateien in Assets und Packages niemals ignorieren!
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta
!/[Pp]roject[Ss]ettings/**/*.meta
