[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.11"
{% if author %}
authors = [
    { name = "{{ author }}"{% if author_email %}, email = "{{ author_email }}"{% endif %} }
]
{% endif %}
{% if license %}
license = { text = "{{ license }}" }
{% endif %}
dependencies = []

[project.scripts]
{{ project_slug }} = "{{ project_slug }}:main"
{% if custom_scripts %}
{% for s_name, s_cmd in custom_scripts.items() %}
{{ s_name }} = "{{ s_cmd }}"
{% endfor %}
{% endif %}

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.6",
]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[build-system]
requires = ["uv_build"]
build-backend = "uv_build"
