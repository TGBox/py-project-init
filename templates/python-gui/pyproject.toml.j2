[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.11"
{% if author %}
authors = [
    { name = "{{ author }}"{% if author_email %}, email = "{{ author_email }}"{% endif %} }
]
{% endif %}
{% if license %}
license = { text = "{{ license }}" }
{% endif %}
dependencies = [
{% if framework == "pyside6" %}
    "pyside6",
{% elif framework == "pyqt6" %}
    "pyqt6",
{% elif framework == "wxpython" %}
    "wxpython",
{% elif framework == "kivy" %}
    "kivy",
{% endif %}
]

[project.scripts]
{{ project_name }} = "src.main:main"
main = "src.main:main"
test = "pytest:main"
build = "src.build:main"
format = "src.tools:format_code"
lint = "src.tools:lint_code"
{% if custom_scripts %}
{% for s_name, s_cmd in custom_scripts.items() %}
{{ s_name }} = "{{ s_cmd }}"
{% endfor %}
{% endif %}

[dependency-groups]
dev = [
    "pytest>=8.0",
    "pyinstaller>=6.0",
    "ruff>=0.6",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src"]

[tool.ruff]
line-length = 100
