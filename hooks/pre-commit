#!/usr/bin/env bash
set -e

# Abbruch, wenn der Aufruf durch den post-commit Hook (Changelog-Amend) ausgelöst wurde
if [ "$GIT_CHANGELOG_RUNNING" = "1" ]; then
  exit 0
fi

# -----------------------------------------------------------------------------
# 1. Große Dateien blockieren (> 10 MB)
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_KB=10240
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || echo "")

for FILE in $STAGED_FILES; do
  if [ -f "$FILE" ]; then
    FILE_SIZE_KB=$(du -k "$FILE" 2>/dev/null | cut -f1 || echo 0)
    if [ "$FILE_SIZE_KB" -gt "$MAX_FILE_SIZE_KB" ]; then
      echo "----------------------------------------------------------------" >&2
      echo "FEHLER: Datei '$FILE' überschreitet das Limit von 10 MB (${FILE_SIZE_KB} KB)." >&2
      echo "Große Binärdateien sollten nicht direkt im Git-Repository versioniert werden." >&2
      echo "----------------------------------------------------------------" >&2
      exit 1
    fi
  fi
done

# -----------------------------------------------------------------------------
# 2. Secrets & .env Scanning
# -----------------------------------------------------------------------------
for FILE in $STAGED_FILES; do
  # Prüfung auf .env Dateien
  if [ "$FILE" = ".env" ] || echo "$FILE" | grep -Eq '(^|/)\.env(\.local|\.production|\.prod)?$'; then
    echo "----------------------------------------------------------------" >&2
    echo "FEHLER: Gestagte Datei '$FILE' enthält möglicherweise sensible Zugangsdaten!" >&2
    echo "Verwenden Sie stattdessen eine unkritische '.env.example'-Datei." >&2
    echo "----------------------------------------------------------------" >&2
    exit 1
  fi

  # Prüfung auf private Schlüssel und Tokens
  if [ -f "$FILE" ]; then
    if grep -Eq 'BEGIN (RSA|OPENSSH|EC|DSA)? PRIVATE KEY' "$FILE" 2>/dev/null; then
      echo "----------------------------------------------------------------" >&2
      echo "FEHLER: Datei '$FILE' enthält einen privaten Schlüssel (Private Key)!" >&2
      echo "Commit abgebrochen aus Sicherheitsgründen." >&2
      echo "----------------------------------------------------------------" >&2
      exit 1
    fi
  fi
done

echo "Pre-Commit Checks erfolgreich abgeschlossen."