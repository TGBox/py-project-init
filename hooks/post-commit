#!/usr/bin/env bash
set -e

# Abbruch, wenn der Aufruf durch den post-commit Hook (Amend) ausgelöst wurde
if [ "$GIT_CHANGELOG_RUNNING" = "1" ]; then
  exit 0
fi

PYTHON_BIN="python3"
if command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v py >/dev/null 2>&1 && py -c "import sys" >/dev/null 2>&1; then
  PYTHON_BIN="py"
fi

# -----------------------------------------------------------------------------
# 1. SemVer Bump (Interaktiv oder automatisch anhand Conventional Commits)
# -----------------------------------------------------------------------------
BUMP=""

# Letzte Commit-Nachricht ermitteln
LAST_COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null || echo "")
FIRST_LINE=$(echo "$LAST_COMMIT_MSG" | head -n 1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# Empfohlenen Bump anhand von Conventional Commits ableiten
DEFAULT_CHOICE="s"
RECOMMENDED_NAME="Überspringen"

if echo "$LAST_COMMIT_MSG" | grep -Eq 'BREAKING[ -]CHANGE' || echo "$FIRST_LINE" | grep -Eq '^[a-zA-Z0-9_-]+(\([^)]+\))?!:' || echo "$FIRST_LINE" | grep -Eq '^breaking(\([^)]+\))?:'; then
  DEFAULT_CHOICE="3"
  RECOMMENDED_NAME="Major"
elif echo "$FIRST_LINE" | grep -Eq '^feat(\([^)]+\))?:'; then
  DEFAULT_CHOICE="2"
  RECOMMENDED_NAME="Minor"
elif echo "$FIRST_LINE" | grep -Eq '^(fix|perf)(\([^)]+\))?:'; then
  DEFAULT_CHOICE="1"
  RECOMMENDED_NAME="Patch"
fi

# Interaktivitätsprüfung: TTY verfügbar und kein automatisierter/übersprungener Modus
INTERACTIVE=0
if [ -z "$CI" ] && [ "${GIT_HOOKS_NON_INTERACTIVE:-0}" != "1" ] && [ "${GIT_HOOKS_SKIP_BUMP:-0}" != "1" ]; then
  if [ "${GIT_HOOKS_FORCE_INTERACTIVE:-0}" = "1" ]; then
    INTERACTIVE=1
  elif [ -t 0 ]; then
    INTERACTIVE=1
  elif [ -t 1 ] || [ -t 2 ]; then
    if [ -e /dev/tty ] && exec < /dev/tty 2>/dev/null; then
      INTERACTIVE=1
    fi
  fi
fi

if [ "$INTERACTIVE" = "1" ]; then
  # Aktuelle Version ermitteln
  CURRENT_VERSION=""
  if [ -f "pyproject.toml" ]; then
    CURRENT_VERSION=$("$PYTHON_BIN" - << 'EOF'
import re
try:
    with open('pyproject.toml', 'r', encoding='utf-8') as f:
        m = re.search(r'version\s*=\s*"(\d+\.\d+\.\d+)"', f.read())
        if m:
            print(m.group(1))
except Exception:
    pass
EOF
)
  elif [ -f "package.json" ]; then
    CURRENT_VERSION=$("$PYTHON_BIN" - << 'EOF'
import json
try:
    with open('package.json', 'r', encoding='utf-8') as f:
        print(json.load(f).get('version', ''))
except Exception:
    pass
EOF
)
  elif [ -f "Cargo.toml" ]; then
    CURRENT_VERSION=$("$PYTHON_BIN" - << 'EOF'
import re
try:
    with open('Cargo.toml', 'r', encoding='utf-8') as f:
        content = f.read()
        m = re.search(r'(?ms)^\[package\].*?^version\s*=\s*"(\d+\.\d+\.\d+)"', content)
        if not m:
            m = re.search(r'version\s*=\s*"(\d+\.\d+\.\d+)"', content)
        if m:
            print(m.group(1))
except Exception:
    pass
EOF
)
  fi

  echo "----------------------------------------"
  if [ -n "$CURRENT_VERSION" ]; then
    echo "Aktuelle Version: v$CURRENT_VERSION"
  fi
  if [ -n "$FIRST_LINE" ]; then
    echo "Commit: $FIRST_LINE"
  fi
  echo "Empfohlener Bump: $RECOMMENDED_NAME ($DEFAULT_CHOICE)"
  echo "----------------------------------------"
  echo "SemVer Bump auswählen:"
  echo "1) Patch"
  echo "2) Minor"
  echo "3) Major"
  echo "s) Überspringen (keine Änderung)"
  echo "----------------------------------------"
  read -r -p "Auswahl [1/2/3/s] (Standard: $DEFAULT_CHOICE): " choice || choice="$DEFAULT_CHOICE"
  [ -z "$choice" ] && choice="$DEFAULT_CHOICE"

  case "$choice" in
    1) BUMP="patch" ;;
    2) BUMP="minor" ;;
    3) BUMP="major" ;;
    s|S|"") echo "Version unverändert gelassen." ;;
    *) echo "Ungültige Auswahl, Version unverändert gelassen." ;;
  esac
else
  # Nicht-interaktiver Modus (z. B. VS Code GUI, Windows-Konsole ohne TTY, automatisierte Tools)
  # Automatischer SemVer-Bump basierend auf Conventional Commits
  if [ "${GIT_HOOKS_SKIP_BUMP:-0}" != "1" ]; then
    case "$DEFAULT_CHOICE" in
      1) BUMP="patch" ;;
      2) BUMP="minor" ;;
      3) BUMP="major" ;;
      *) BUMP="" ;;
    esac
    if [ -n "$BUMP" ]; then
      echo "Automatischer SemVer Bump ($BUMP) basierend auf Commit: $FIRST_LINE"
    fi
  fi
fi

if [ -n "$BUMP" ]; then
  # ---------------------------------------------------------------------------
  # Python-Projekt (pyproject.toml & uv.lock)
  # ---------------------------------------------------------------------------
  if [ -f "pyproject.toml" ]; then
    "$PYTHON_BIN" -c "
import re, sys

part = '$BUMP'
file = 'pyproject.toml'

with open(file, 'r', encoding='utf-8') as f:
    content = f.read()

m = re.search(r'version\s*=\s*\"(\d+)\.(\d+)\.(\d+)\"', content)
if m:
    major, minor, patch = map(int, m.groups())
    if part == 'major':
        major += 1
        minor = 0
        patch = 0
    elif part == 'minor':
        minor += 1
        patch = 0
    elif part == 'patch':
        patch += 1

    new_ver = f'{major}.{minor}.{patch}'
    content = re.sub(r'version\s*=\s*\"\d+\.\d+\.\d+\"', f'version = \"{new_ver}\"', content, count=1)

    with open(file, 'w', encoding='utf-8') as f:
        f.write(content)

    print(f'pyproject.toml: {m.group(1)}.{m.group(2)}.{m.group(3)} -> {new_ver}')
"
    git add pyproject.toml

    if [ -f "uv.lock" ] && command -v uv >/dev/null 2>&1; then
      uv lock
      git add uv.lock
      echo "uv.lock aktualisiert und gestaged."
    fi
  fi

  # ---------------------------------------------------------------------------
  # Node/TypeScript-Projekt (package.json & package-lock.json)
  # ---------------------------------------------------------------------------
  if [ -f "package.json" ]; then
    BUMPED_NPM=0
    if command -v npm >/dev/null 2>&1; then
      if npm version "$BUMP" --no-git-tag-version 2>/dev/null; then
        BUMPED_NPM=1
        git add package.json
        if [ -f "package-lock.json" ]; then
          git add package-lock.json
        fi
      fi
    fi

    # Fallback mit Python falls npm nicht verfügbar ist oder fehlschlug
    if [ "$BUMPED_NPM" = "0" ]; then
      "$PYTHON_BIN" -c "
import re, json

part = '$BUMP'
file = 'package.json'

with open(file, 'r', encoding='utf-8') as f:
    content = f.read()

m = re.search(r'(\"version\"\s*:\s*\")(\d+)\.(\d+)\.(\d+)(\")', content)
if m:
    major, minor, patch = int(m.group(2)), int(m.group(3)), int(m.group(4))
    if part == 'major':
        major += 1
        minor = 0
        patch = 0
    elif part == 'minor':
        minor += 1
        patch = 0
    elif part == 'patch':
        patch += 1

    new_ver = f'{major}.{minor}.{patch}'
    content = content[:m.start()] + f'{m.group(1)}{new_ver}{m.group(5)}' + content[m.end():]

    with open(file, 'w', encoding='utf-8') as f:
        f.write(content)

    print(f'package.json: {m.group(2)}.{m.group(3)}.{m.group(4)} -> {new_ver}')

    try:
        with open('package-lock.json', 'r', encoding='utf-8') as lf:
            lock_data = json.load(lf)
        lock_data['version'] = new_ver
        if 'packages' in lock_data and '' in lock_data['packages']:
            lock_data['packages']['']['version'] = new_ver
        with open('package-lock.json', 'w', encoding='utf-8') as lf:
            json.dump(lock_data, lf, indent=2)
            lf.write('\n')
    except Exception:
        pass
"
      git add package.json
      if [ -f "package-lock.json" ]; then
        git add package-lock.json
      fi
    fi
  fi

  # ---------------------------------------------------------------------------
  # Rust-Projekt (Cargo.toml & Cargo.lock)
  # ---------------------------------------------------------------------------
  if [ -f "Cargo.toml" ]; then
    "$PYTHON_BIN" -c "
import re

part = '$BUMP'
file = 'Cargo.toml'

with open(file, 'r', encoding='utf-8') as f:
    content = f.read()

m = re.search(r'(?ms)(^\[package\].*?^version\s*=\s*\")(\d+)\.(\d+)\.(\d+)(\")', content)
if not m:
    m = re.search(r'(^version\s*=\s*\")(\d+)\.(\d+)\.(\d+)(\")', content, flags=re.MULTILINE)

if m:
    major, minor, patch = int(m.group(2)), int(m.group(3)), int(m.group(4))
    if part == 'major':
        major += 1
        minor = 0
        patch = 0
    elif part == 'minor':
        minor += 1
        patch = 0
    elif part == 'patch':
        patch += 1

    new_ver = f'{major}.{minor}.{patch}'
    old_full = m.group(0)
    new_full = f'{m.group(1)}{new_ver}{m.group(5)}'
    content = content.replace(old_full, new_full, 1)

    with open(file, 'w', encoding='utf-8') as f:
        f.write(content)

    print(f'Cargo.toml: {major}.{minor}.{patch} -> {new_ver}')
"
    git add Cargo.toml

    if [ -f "Cargo.lock" ] && command -v cargo >/dev/null 2>&1; then
      cargo check --quiet 2>/dev/null || cargo metadata --format-version 1 >/dev/null 2>&1 || true
      git add Cargo.lock
      echo "Cargo.lock aktualisiert und gestaged."
    fi
  fi
fi

# -----------------------------------------------------------------------------
# 2. Changelog-Generierung
# -----------------------------------------------------------------------------
"$PYTHON_BIN" - << 'EOF'
import subprocess
import re
import json
import os
from collections import defaultdict

# 1. Bestehende H1-Überschrift einlesen
header = "# Changelog"
try:
    with open("CHANGELOG.md", "r", encoding="utf-8") as f:
        for line in f:
            if line.startswith("# "):
                header = line.strip()
                break
except Exception:
    pass

# 2. Alle Commits chronologisch (alt nach neu) inkl. geänderter Dateien holen
raw = subprocess.check_output(
    ["git", "log", "--reverse", "--name-only", "--pretty=format:COMMIT:%h\t%ad\t%s", "--date=short"],
    text=True
)

commits = []
curr = None
for line in raw.splitlines():
    if line.startswith("COMMIT:"):
        parts = line[7:].split("\t", 2)
        if len(parts) == 3:
            h, ad, s = parts
            curr = {"hash": h, "line": f"{ad} ({h}): {s}", "files": []}
            commits.append(curr)
    elif curr and line.strip():
        curr["files"].append(line.strip())

def get_version_at_commit(commit_hash):
    for fname in ("pyproject.toml", "package.json", "Cargo.toml"):
        try:
            content = subprocess.check_output(
                ["git", "show", f"{commit_hash}:{fname}"],
                stderr=subprocess.DEVNULL,
                text=True
            )
            if fname in ("pyproject.toml", "Cargo.toml"):
                m = re.search(r'version\s*=\s*"(\d+\.\d+\.\d+)"', content)
                if m:
                    return m.group(1)
            elif fname == "package.json":
                data = json.loads(content)
                if "version" in data:
                    return str(data["version"])
        except Exception:
            pass
    return None

def get_current_working_version():
    for fname in ("pyproject.toml", "package.json", "Cargo.toml"):
        try:
            if fname in ("pyproject.toml", "Cargo.toml") and os.path.isfile(fname):
                with open(fname, "r", encoding="utf-8") as f:
                    m = re.search(r'version\s*=\s*"(\d+\.\d+\.\d+)"', f.read())
                    if m:
                        return m.group(1)
            elif fname == "package.json" and os.path.isfile("package.json"):
                with open("package.json", "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if "version" in data:
                        return str(data["version"])
        except Exception:
            pass
    return None

# 3. Commits den jeweiligen Versionen zuordnen
version_order = []
version_commits = defaultdict(list)
current_ver = None
working_ver = get_current_working_version()

for i, c in enumerate(commits):
    is_latest = (i == len(commits) - 1)
    touched = any(f in ("pyproject.toml", "package.json", "Cargo.toml") for f in c["files"])
    
    if is_latest and working_ver:
        # Neueste Version aus Arbeitskopie übernehmen (falls soeben gebumpt oder vorhanden)
        current_ver = working_ver
    elif current_ver is None or touched:
        v = get_version_at_commit(c["hash"])
        if v:
            current_ver = v

    ver_key = current_ver or "Unreleased"
    if ver_key not in version_order:
        version_order.append(ver_key)
    version_commits[ver_key].append(c["line"])

# 4. Changelog linter-konform zusammenbauen (neueste Version & Commits oben)
sections = []
for ver in reversed(version_order):
    title = f"## SemVer v{ver}" if ver != "Unreleased" else "## Unreleased"
    sec = [title, ""]
    for c_line in reversed(version_commits[ver]):
        sec.append(f"- {c_line}")
    sections.append("\n".join(sec))

output = header + "\n\n" + "\n\n".join(sections) + "\n"

with open("CHANGELOG.md", "w", encoding="utf-8") as f:
    f.write(output)
EOF

# -----------------------------------------------------------------------------
# 3. Bei Änderungen per Amend committen
# -----------------------------------------------------------------------------
git add CHANGELOG.md

if ! git diff --cached --quiet; then
  export GIT_CHANGELOG_RUNNING=1
  git commit --no-verify --amend --no-edit
fi

# -----------------------------------------------------------------------------
# 4. Optional: Automatisches Git-Tagging
# -----------------------------------------------------------------------------
AUTO_TAG=$(git config --bool hooks.autotag 2>/dev/null || echo "false")
if [ "$AUTO_TAG" = "true" ] && [ -n "$BUMP" ]; then
  NEW_VERSION=""
  if [ -f "pyproject.toml" ]; then
    NEW_VERSION=$("$PYTHON_BIN" - << 'EOF'
import re
try:
    with open('pyproject.toml', 'r', encoding='utf-8') as f:
        m = re.search(r'version\s*=\s*"(\d+\.\d+\.\d+)"', f.read())
        if m:
            print(m.group(1))
except Exception:
    pass
EOF
)
  elif [ -f "package.json" ]; then
    NEW_VERSION=$("$PYTHON_BIN" - << 'EOF'
import json
try:
    with open('package.json', 'r', encoding='utf-8') as f:
        print(json.load(f).get('version', ''))
except Exception:
    pass
EOF
)
  elif [ -f "Cargo.toml" ]; then
    NEW_VERSION=$("$PYTHON_BIN" - << 'EOF'
import re
try:
    with open('Cargo.toml', 'r', encoding='utf-8') as f:
        content = f.read()
        m = re.search(r'(?ms)^\[package\].*?^version\s*=\s*"(\d+\.\d+\.\d+)"', content)
        if not m:
            m = re.search(r'version\s*=\s*"(\d+\.\d+\.\d+)"', content)
        if m:
            print(m.group(1))
except Exception:
    pass
EOF
)
  fi

  if [ -n "$NEW_VERSION" ]; then
    TAG_NAME="v$NEW_VERSION"
    git tag -a "$TAG_NAME" -m "Release $TAG_NAME" -f
    echo "✔ Git-Tag '$TAG_NAME' auf aktuellen Commit gesetzt."

    # Sicherstellen, dass Git Tags bei 'git push' automatisch überträgt
    if [ "$(git config --bool push.followTags 2>/dev/null)" != "true" ]; then
      git config push.followTags true
    fi
  fi
fi

