#!/usr/bin/env bash
set -e

UPSTREAM="$1"
BRANCH="$2"

if [ -z "$BRANCH" ]; then
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
fi

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
    echo "----------------------------------------------------------------" >&2
    echo "FEHLER: Rebase auf dem Haupt-Branch ('$BRANCH') ist blockiert!" >&2
    echo "Das Umschreiben veröffentlichter Historie führt zu Konflikten." >&2
    echo "Wechseln Sie auf einen Feature-Branch, bevor Sie rebasen." >&2
    echo "----------------------------------------------------------------" >&2
    exit 1
fi
