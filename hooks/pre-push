#!/usr/bin/env bash
set -e

REMOTE="$1"
URL="$2"

# Git übergibt die zu pushenden Refs via Stdin:
# <local ref> <local sha> <remote ref> <remote sha>
PUSH_LINES=()
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    LOCAL_REF="${LOCAL_REF%$'\r'}"
    LOCAL_SHA="${LOCAL_SHA%$'\r'}"
    REMOTE_REF="${REMOTE_REF%$'\r'}"
    REMOTE_SHA="${REMOTE_SHA%$'\r'}"
    if [ -z "$LOCAL_REF" ]; then
        continue
    fi
    if [ "$REMOTE_REF" = "refs/heads/main" ] || [ "$REMOTE_REF" = "refs/heads/master" ]; then
        echo "----------------------------------------------------------------" >&2
        echo "FEHLER: Direkter Push auf '$REMOTE_REF' ist blockiert!" >&2
        echo "Bitte verwenden Sie einen Feature-Branch und erstellen Sie einen Pull Request." >&2
        echo "----------------------------------------------------------------" >&2
        exit 1
    fi
    PUSH_LINES+=("$LOCAL_REF $LOCAL_SHA $REMOTE_REF $REMOTE_SHA")
done

if [ "$GIT_PRE_PUSH_SKIP_TESTS" = "1" ]; then
    exit 0
fi

# -----------------------------------------------------------------------------
# Smarte Testausführung (hooks.smarttests):
# Wenn aktiviert, wird geprüft, ob seit dem letzten Push Codedateien geändert wurden.
# Wurden nur Konfigurations-, Doku- oder Asset-Dateien geändert, wird das Test-Gate übersprungen.
# Wurde mindestens eine Codedatei verändert, werden alle Tests ausgeführt.
# -----------------------------------------------------------------------------
SMART_TESTS=$(git config --bool hooks.smarttests 2>/dev/null || echo "false")
if [ "$GIT_PRE_PUSH_SMART_TESTS" = "1" ] || [ "$GIT_PRE_PUSH_SMART_TESTS" = "true" ]; then
    SMART_TESTS="true"
elif [ "$GIT_PRE_PUSH_SMART_TESTS" = "0" ] || [ "$GIT_PRE_PUSH_SMART_TESTS" = "false" ]; then
    SMART_TESTS="false"
fi

if [ "$SMART_TESTS" = "true" ]; then
    CHANGED_FILES=""
    ALL_DELETIONS=1

    if [ ${#PUSH_LINES[@]} -gt 0 ]; then
        for line in "${PUSH_LINES[@]}"; do
            read -r L_REF L_SHA R_REF R_SHA <<< "$line"
            L_REF="${L_REF%$'\r'}"
            L_SHA="${L_SHA%$'\r'}"
            R_REF="${R_REF%$'\r'}"
            R_SHA="${R_SHA%$'\r'}"
            if [ -z "$L_SHA" ] || [ "$L_SHA" = "0000000000000000000000000000000000000000" ] || [ "$L_SHA" = "000000" ]; then
                continue
            fi
            ALL_DELETIONS=0

            if [ "$R_SHA" = "0000000000000000000000000000000000000000" ] || [ "$R_SHA" = "000000" ]; then
                # Neuer Branch: Ermittle gemeinsamen Vorfahren mit remote default branch oder lokalem main
                BASE_REF=$(git merge-base "$L_SHA" "$REMOTE/main" 2>/dev/null || git merge-base "$L_SHA" origin/main 2>/dev/null || git merge-base "$L_SHA" main 2>/dev/null || git merge-base "$L_SHA" master 2>/dev/null || true)
                if [ -n "$BASE_REF" ]; then
                    DIFF_FILES=$(git diff --name-only "$BASE_REF" "$L_SHA" 2>/dev/null || true)
                else
                    DIFF_FILES=$(git diff-tree --no-commit-id --name-only -r "$L_SHA" 2>/dev/null || true)
                fi
            else
                DIFF_FILES=$(git diff --name-only "$R_SHA" "$L_SHA" 2>/dev/null || true)
            fi
            CHANGED_FILES=$(printf "%s\n%s" "$CHANGED_FILES" "$DIFF_FILES")
        done

        if [ "$ALL_DELETIONS" = "1" ]; then
            # Nur Branch-Löschungen, keine Tests notwendig
            exit 0
        fi
    else
        # Fallback (z.B. manuelle Hook-Ausführung ohne Stdin)
        UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
        if [ -n "$UPSTREAM" ]; then
            CHANGED_FILES=$(git diff --name-only "$UPSTREAM..HEAD" 2>/dev/null || true)
        else
            BASE_REF=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || true)
            if [ -n "$BASE_REF" ]; then
                CHANGED_FILES=$(git diff --name-only "$BASE_REF..HEAD" 2>/dev/null || true)
            else
                CHANGED_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || true)
            fi
        fi
    fi

    # Bereinigen und Duplikate entfernen
    CLEAN_CHANGED=$(echo "$CHANGED_FILES" | sed '/^[[:space:]]*$/d' | sort -u)

    # Prüfe auf gängige Quellcode-Dateiendungen
    CODE_CHANGES=$(echo "$CLEAN_CHANGED" | grep -Ei '\.(py|rs|ts|tsx|js|jsx|mjs|cjs|vue|svelte|cs|shader|asmdef|go|c|cpp|cc|cxx|h|hpp|sh|bash|ps1)$' || true)

    if [ -z "$CODE_CHANGES" ]; then
        echo "----------------------------------------------------------------"
        echo "Smarte Testausführung aktiv (hooks.smarttests):"
        echo "Keine Codedateien verändert (nur Konfiguration/Dokumentation)."
        echo "Test-Gate wird übersprungen."
        echo "----------------------------------------------------------------"
        exit 0
    else
        echo "Smarte Testausführung aktiv: Codedateien wurden verändert -> Führe vollständige Testsuite aus."
    fi
fi

# -----------------------------------------------------------------------------
# Test-Ausführung (Benutzerdefiniert via hooks.testcmd oder Auto-Erkennung):
# -----------------------------------------------------------------------------
TEST_CMD=$(git config hooks.testcmd 2>/dev/null || echo "")

if [ -n "$TEST_CMD" ]; then
    echo "Führe benutzerdefinierten Test-Befehl vor dem Push aus ($TEST_CMD)..."
    set +e
    ( eval "$TEST_CMD" )
    TEST_EXIT=$?
    set -e
    if [ $TEST_EXIT -ne 0 ]; then
        echo "FEHLER: Test-Befehl ($TEST_CMD) vor dem Push fehlgeschlagen. Push abgebrochen." >&2
        exit 1
    fi
elif [ -f "pyproject.toml" ] && command -v uv >/dev/null 2>&1 && [ -d "tests" ]; then
    if uv run pytest --version >/dev/null 2>&1; then
        echo "Führe pytest vor dem Push aus..."
        uv run pytest -q || {
            echo "FEHLER: pytest vor dem Push fehlgeschlagen. Push abgebrochen." >&2
            exit 1
        }
    fi
elif [ -f "Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
    echo "Führe cargo test vor dem Push aus..."
    cargo test -q || {
        echo "FEHLER: cargo test vor dem Push fehlgeschlagen. Push abgebrochen." >&2
        exit 1
    }
elif [ -f "package.json" ]; then
    if command -v npm >/dev/null 2>&1 && npm run 2>/dev/null | grep -q "test"; then
        echo "Führe npm test vor dem Push aus..."
        npm test || {
            echo "FEHLER: npm test vor dem Push fehlgeschlagen. Push abgebrochen." >&2
            exit 1
        }
    elif command -v npx >/dev/null 2>&1 && [ -f "node_modules/.bin/vitest" ]; then
        echo "Führe vitest vor dem Push aus..."
        npx vitest run || {
            echo "FEHLER: vitest vor dem Push fehlgeschlagen. Push abgebrochen." >&2
            exit 1
        }
    fi
elif [ -f "ProjectSettings/ProjectVersion.txt" ]; then
    if command -v Unity >/dev/null 2>&1; then
        echo "Führe Unity Test Runner vor dem Push aus..."
        Unity -batchmode -runTests -projectPath . -testPlatform PlayMode -testResults tests/results.xml || {
            echo "FEHLER: Unity Tests vor dem Push fehlgeschlagen. Push abgebrochen." >&2
            exit 1
        }
    fi
elif ([ -f "*.sln" ] || compgen -G "*.sln" >/dev/null 2>&1 || compgen -G "*/*.csproj" >/dev/null 2>&1) && command -v dotnet >/dev/null 2>&1; then
    echo "Führe dotnet test vor dem Push aus..."
    dotnet test -q || {
        echo "FEHLER: dotnet test vor dem Push fehlgeschlagen. Push abgebrochen." >&2
        exit 1
    }
fi

# -----------------------------------------------------------------------------
# Tag-Erneuerung beim Push (hooks.renewtagonpush)
# -----------------------------------------------------------------------------
RENEW_TAG=$(git config --bool hooks.renewtagonpush 2>/dev/null || echo "false")
if [ "$RENEW_TAG" = "true" ]; then
    CURRENT_VERSION=""
    PYTHON_BIN="python3"
    if command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
        PYTHON_BIN="python3"
    elif command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
        PYTHON_BIN="python"
    elif command -v py >/dev/null 2>&1 && py -c "import sys" >/dev/null 2>&1; then
        PYTHON_BIN="py"
    fi

    if [ -f "pyproject.toml" ]; then
        CURRENT_VERSION=$("$PYTHON_BIN" - << 'EOF'
import re
try:
    with open('pyproject.toml', 'r', encoding='utf-8') as f:
        m = re.search(r'version\s*=\s*["\'](\d+\.\d+\.\d+)["\']', f.read())
        if m:
            print(m.group(1))
except Exception:
    pass
EOF
)
    elif [ -f "package.json" ]; then
        CURRENT_VERSION=$("$PYTHON_BIN" - << 'EOF'
import json
try:
    with open('package.json', 'r', encoding='utf-8') as f:
        print(json.load(f).get('version', ''))
except Exception:
    pass
EOF
)
    elif [ -f "Cargo.toml" ]; then
        CURRENT_VERSION=$("$PYTHON_BIN" - << 'EOF'
import re
try:
    with open('Cargo.toml', 'r', encoding='utf-8') as f:
        content = f.read()
        m = re.search(r'(?ms)^\[package\].*?^version\s*=\s*["\'](\d+\.\d+\.\d+)["\']', content)
        if not m:
            m = re.search(r'version\s*=\s*["\'](\d+\.\d+\.\d+)["\']', content)
        if m:
            print(m.group(1))
except Exception:
    pass
EOF
)
    elif [ -f "ProjectSettings/ProjectSettings.asset" ]; then
        CURRENT_VERSION=$("$PYTHON_BIN" - << 'EOF'
import re
try:
    with open('ProjectSettings/ProjectSettings.asset', 'r', encoding='utf-8') as f:
        m = re.search(r'bundleVersion:\s*["\']?(\d+\.\d+\.\d+)["\']?', f.read())
        if m:
            print(m.group(1))
except Exception:
    pass
EOF
)
    fi

    if [ -z "$CURRENT_VERSION" ]; then
        if [ -f "VERSION" ]; then
            CURRENT_VERSION=$(head -n 1 VERSION 2>/dev/null | tr -d '[:space:]')
        else
            LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
            if [ -n "$LATEST_TAG" ]; then
                CURRENT_VERSION=$(echo "$LATEST_TAG" | sed -e 's/^v//')
            fi
        fi
    fi
    CURRENT_VERSION=$(echo "$CURRENT_VERSION" | sed -e 's/^v//')

    if [ -n "$CURRENT_VERSION" ]; then
        TAG_NAME="v$CURRENT_VERSION"
        TAG_SHA=$(git rev-list -n 1 "$TAG_NAME" 2>/dev/null || echo "")
        HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")

        if [ "$TAG_SHA" != "$HEAD_SHA" ]; then
            echo "----------------------------------------------------------------"
            echo "Tag-Erneuerung aktiv (hooks.renewtagonpush):"
            echo "Setze Tag '$TAG_NAME' auf aktuellen HEAD ($HEAD_SHA)..."
            git tag -a "$TAG_NAME" -m "Release $TAG_NAME" -f
            echo "Tag '$TAG_NAME' erfolgreich auf HEAD aktualisiert."
            echo "----------------------------------------------------------------"
        fi

        if [ "$(git config --bool push.followTags 2>/dev/null)" != "true" ]; then
            git config push.followTags true
        fi

        if [ -n "$REMOTE" ] && [ "$REMOTE" != "" ]; then
            git push "$REMOTE" "$TAG_NAME" --force >/dev/null 2>&1 || true
        fi
    fi
fi

# -----------------------------------------------------------------------------
# Automatischer Exe-Build vor dem Push (hooks.buildexe)
# -----------------------------------------------------------------------------
BUILD_EXE=$(git config --bool hooks.buildexe 2>/dev/null || echo "false")
if [ "$BUILD_EXE" = "true" ]; then
    BUILD_CMD=$(git config hooks.buildcmd 2>/dev/null || echo "")

    if [ -z "$BUILD_CMD" ]; then
        if compgen -G "*.spec" >/dev/null 2>&1; then
            SPEC_FILE=$(compgen -G "*.spec" | head -n 1)
            if command -v uv >/dev/null 2>&1; then
                BUILD_CMD="uv run pyinstaller \"$SPEC_FILE\""
            elif command -v pyinstaller >/dev/null 2>&1; then
                BUILD_CMD="pyinstaller \"$SPEC_FILE\""
            fi
        elif [ -f "pyproject.toml" ] && ( [ -f "src/main.py" ] || [ -f "main.py" ] ); then
            ENTRY="main.py"
            [ -f "src/main.py" ] && ENTRY="src/main.py"
            if command -v uv >/dev/null 2>&1; then
                BUILD_CMD="uv run pyinstaller \"$ENTRY\" --onefile"
            elif command -v pyinstaller >/dev/null 2>&1; then
                BUILD_CMD="pyinstaller \"$ENTRY\" --onefile"
            fi
        elif [ -f "Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
            BUILD_CMD="cargo build --release"
        elif ([ -f "*.sln" ] || compgen -G "*.sln" >/dev/null 2>&1 || compgen -G "*/*.csproj" >/dev/null 2>&1) && command -v dotnet >/dev/null 2>&1; then
            BUILD_CMD="dotnet publish -c Release"
        fi
    fi

    if [ -z "$BUILD_CMD" ]; then
        echo "FEHLER: hooks.buildexe ist aktiv, aber es konnte kein Build-Befehl ermittelt werden." >&2
        echo "Bitte 'git config hooks.buildcmd \"<befehl>\"' setzen." >&2
        exit 1
    fi

    echo "----------------------------------------------------------------"
    echo "Führe Exe-Build vor dem Push aus ($BUILD_CMD)..."
    echo "----------------------------------------------------------------"
    set +e
    ( eval "$BUILD_CMD" )
    BUILD_EXIT=$?
    set -e
    if [ $BUILD_EXIT -ne 0 ]; then
        echo "FEHLER: Exe-Build vor dem Push fehlgeschlagen ($BUILD_CMD). Push abgebrochen." >&2
        exit 1
    fi
    echo "✔ Exe-Build erfolgreich abgeschlossen."
fi

# -----------------------------------------------------------------------------
# Artefakt-Deployment ins externe Repository (hooks.deployartifact)
# -----------------------------------------------------------------------------
DEPLOY_ARTIFACT=$(git config --bool hooks.deployartifact 2>/dev/null || echo "false")
if [ "$DEPLOY_ARTIFACT" = "true" ]; then
    EXTERNAL_REPO=$(git config hooks.externalrepo 2>/dev/null || echo "")
    if [ -z "$EXTERNAL_REPO" ]; then
        echo "FEHLER: hooks.deployartifact ist aktiv, aber hooks.externalrepo ist nicht konfiguriert." >&2
        echo "Bitte 'git config hooks.externalrepo \"<git-url-oder-pfad>\"' setzen." >&2
        exit 1
    fi

    EXTERNAL_BRANCH=$(git config hooks.externalrepobranch 2>/dev/null || echo "main")
    [ -z "$EXTERNAL_BRANCH" ] && EXTERNAL_BRANCH="main"

    EXTERNAL_DIR=$(git config hooks.externalrepodir 2>/dev/null || echo "releases")
    [ -z "$EXTERNAL_DIR" ] && EXTERNAL_DIR="releases"

    ARTIFACT_PATTERN=$(git config hooks.artifactpattern 2>/dev/null || echo "dist/*.exe")
    [ -z "$ARTIFACT_PATTERN" ] && ARTIFACT_PATTERN="dist/*.exe"

    echo "----------------------------------------------------------------"
    echo "Artefakt-Deployment aktiv (hooks.deployartifact):"
    echo "Suche Artefakte nach Muster '$ARTIFACT_PATTERN'..."

    MATCHING_FILES=()
    for f in $ARTIFACT_PATTERN; do
        if [ -f "$f" ]; then
            MATCHING_FILES+=("$f")
        fi
    done

    if [ ${#MATCHING_FILES[@]} -eq 0 ]; then
        echo "FEHLER: Keine Artefakte gefunden, die dem Muster '$ARTIFACT_PATTERN' entsprechen!" >&2
        echo "Push abgebrochen." >&2
        exit 1
    fi

    SOURCE_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
    SOURCE_VERSION=$(git describe --tags --abbrev=0 2>/dev/null || echo "$SOURCE_COMMIT")

    TMP_SYNC_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t 'artifact_sync')

    echo "Synchronisiere externes Repository ($EXTERNAL_REPO, Branch: $EXTERNAL_BRANCH)..."
    if git clone --depth 1 --branch "$EXTERNAL_BRANCH" "$EXTERNAL_REPO" "$TMP_SYNC_DIR" 2>/dev/null; then
        echo "Bestehenden Branch '$EXTERNAL_BRANCH' ausgecheckt."
    else
        echo "Branch '$EXTERNAL_BRANCH' nicht vorhanden oder neues Repo, initialisiere..."
        git clone "$EXTERNAL_REPO" "$TMP_SYNC_DIR" 2>/dev/null || {
            mkdir -p "$TMP_SYNC_DIR"
            git -C "$TMP_SYNC_DIR" init
            git -C "$TMP_SYNC_DIR" remote add origin "$EXTERNAL_REPO"
        }
        git -C "$TMP_SYNC_DIR" checkout -B "$EXTERNAL_BRANCH"
    fi

    TARGET_FOLDER="$TMP_SYNC_DIR/$EXTERNAL_DIR"
    mkdir -p "$TARGET_FOLDER"

    for art in "${MATCHING_FILES[@]}"; do
        cp -f "$art" "$TARGET_FOLDER/"
        echo "Kopiert: $art -> $EXTERNAL_DIR/$(basename "$art")"
    done

    git -C "$TMP_SYNC_DIR" config user.name "$(git config user.name 2>/dev/null || echo 'Project Scaffolder')"
    git -C "$TMP_SYNC_DIR" config user.email "$(git config user.email 2>/dev/null || echo 'scaffolder@localhost')"
    git -C "$TMP_SYNC_DIR" add -A

    if git -C "$TMP_SYNC_DIR" diff --cached --quiet; then
        echo "Keine Änderungen am Artefakt im externen Repository (bereits aktuell)."
    else
        git -C "$TMP_SYNC_DIR" commit -m "Release $SOURCE_VERSION ($SOURCE_COMMIT)" --no-verify
        echo "Pushe Artefakt ins externe Repository..."
        git -C "$TMP_SYNC_DIR" push -u origin "$EXTERNAL_BRANCH" || {
            rm -rf "$TMP_SYNC_DIR" 2>/dev/null || true
            echo "FEHLER: Push ins externe Repository ($EXTERNAL_REPO) fehlgeschlagen!" >&2
            exit 1
        }
        echo "✔ Artefakt erfolgreich im externen Repository aktualisiert."
    fi
    rm -rf "$TMP_SYNC_DIR" 2>/dev/null || true
    echo "----------------------------------------------------------------"
fi

